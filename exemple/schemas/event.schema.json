{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/event.schema.json",
  "title": "Evenement metier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId", "eventType", "eventVersion", "occurredAt", "aggregateType",
    "aggregateId", "aggregateVersion", "payload"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": {
      "type": "string",
      "enum": [
        "UserRegistered", "ListingPublished", "ListingUpdated",
        "ReservationRequested", "ReservationConfirmed", "ReservationRejected",
        "ReservationCancelled", "StayCompleted", "MessageSent", "ReviewSubmitted"
      ]
    },
    "eventVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "aggregateType": {
      "type": "string",
      "enum": ["User", "Listing", "Reservation", "Message", "Review"]
    },
    "aggregateId": { "type": "string", "minLength": 1 },
    "aggregateVersion": { "type": "integer", "minimum": 1 },
    "correlationId": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  }
}
