{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/listing.schema.json",
  "title": "Annonce",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "listingId", "hostId", "title", "description", "location", "capacity",
    "amenities", "nightlyPrice", "currency", "photos", "status", "createdAt", "version"
  ],
  "properties": {
    "listingId": { "type": "string", "minLength": 1 },
    "hostId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 5, "maxLength": 120 },
    "description": { "type": "string", "minLength": 20, "maxLength": 5000 },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "countryCode"],
      "properties": {
        "city": { "type": "string", "minLength": 1 },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "address": { "type": ["string", "null"] },
        "coordinates": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guests", "bedrooms", "beds", "bathrooms"],
      "properties": {
        "guests": { "type": "integer", "minimum": 1 },
        "bedrooms": { "type": "integer", "minimum": 0 },
        "beds": { "type": "integer", "minimum": 1 },
        "bathrooms": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "amenities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "nightlyPrice": { "type": "number", "exclusiveMinimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "position"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "position": { "type": "integer", "minimum": 0 },
          "caption": { "type": ["string", "null"], "maxLength": 200 }
        }
      }
    },
    "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED", "PAUSED", "ARCHIVED"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
